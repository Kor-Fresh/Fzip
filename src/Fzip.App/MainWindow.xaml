<Window x:Class="Fzip.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Fzip — 가볍게 압축하고, 간편하게 풀다" Width="1120" Height="760" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F4F7FC" FontFamily="Malgun Gothic" FontSize="13"
 Foreground="{StaticResource Ink}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101F38"><Grid Margin="22,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Fzip" FontSize="39" FontWeight="Bold" Foreground="White"/><TextBlock Text="작고 가벼운 압축 도우미" Foreground="#9DAFC9" Margin="0,6,0,32"/></StackPanel>
   <StackPanel Grid.Row="1">
    <Button Content="압축파일 열기" Click="OpenClick" Background="#246BEB" Foreground="White" Margin="0,0,0,10"/>
    <Button Content="새 압축 만들기" Click="CreateClick" Background="#22334F" Foreground="#E1E9F6" Margin="0,0,0,10"/>
    <Button Content="기본 앱 설정" Click="DefaultsClick" Background="#22334F" Foreground="#E1E9F6"/>
   </StackPanel>
   <StackPanel Grid.Row="3"><TextBlock Text="Fzip 0.1.1 · Preview" Foreground="#A9BAD2"/><TextBlock Text="7-Zip + EggDotNet" Foreground="#7188A9" FontSize="11" Margin="0,5,0,12"/><Button Content="프로그램 정보 · 라이선스" Click="AboutClick" Background="#22334F" Foreground="#DCE7F8" Padding="8,8"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="30,26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18"><TextBlock Text="내 파일, 더 간편하게" FontSize="22" FontWeight="Bold"/><Border DockPanel.Dock="Right" Background="#E3ECFF" CornerRadius="12" Padding="10,5" HorizontalAlignment="Right"><TextBlock Text="무료 · 로컬 처리" Foreground="#2561BD" FontSize="11"/></Border></DockPanel>
   <Border Grid.Row="1" Background="#E6EFFF" CornerRadius="18" ClipToBounds="True"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
    <StackPanel Margin="26,22,0,20" VerticalAlignment="Center"><TextBlock Text="압축은 가볍게.&#x0a;파일은 안전하게." FontSize="26" FontWeight="Bold" LineHeight="35"/><TextBlock Text="압축파일을 끌어 놓거나, 열어서 시작하세요." Foreground="#536B8A" Margin="0,12,0,0"/><TextBlock Text="ZIP · 7z · RAR · ARJ · ALZ · EGG" FontSize="11" Foreground="#4771A4" Margin="0,10,0,0"/></StackPanel>
    <Image Grid.Column="1" Source="Assets/mascot.png" Margin="0,4,12,-17" Stretch="Uniform"/>
   </Grid></Border>
   <Grid Grid.Row="2" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="ArchiveTitle" Text="열린 압축파일이 없습니다" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ArchiveSummary" Text="파일 목록과 크기가 여기에 표시됩니다." Foreground="#75869D" Margin="0,5,12,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ExtractButton" Content="모두 풀기" Click="ExtractClick" Background="#1467E9" Foreground="White" IsEnabled="False"/><Button x:Name="FolderButton" Content="결과 폴더" Click="FolderClick" Margin="8,0,0,0" IsEnabled="False"/></StackPanel>
   </Grid>
   <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E0E7F2" BorderThickness="1" ClipToBounds="True">
    <Grid><DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EFF3F9" BorderThickness="0" Background="White" RowHeight="36" HeadersVisibility="Column" EnableRowVirtualization="True" SelectionMode="Extended">
     <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFD"/><Setter Property="Padding" Value="12"/><Setter Property="Foreground" Value="#657892"/></Style></DataGrid.ColumnHeaderStyle>
     <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,4"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.CellStyle>
     <DataGrid.Columns><DataGridTextColumn Header="이름 / 경로" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="크기" Binding="{Binding DisplaySize}" Width="105"/><DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="100"/></DataGrid.Columns>
    </DataGrid><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><Image Source="Assets/archive.png" Width="68" Height="68" Opacity="0.7"/><TextBlock Text="여기에 압축파일을 놓으세요" Foreground="#8798AF" Margin="0,12"/></StackPanel></Grid>
   </Border>
   <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="StatusText" Text="준비되었습니다." Foreground="#60738D" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Height="5" Margin="0,10,0,0" Foreground="#2676EE" Background="#E2EAF5" BorderThickness="0"/></StackPanel>
    <Button x:Name="CancelButton" Grid.Column="1" Content="취소" Click="CancelClick" IsEnabled="False" Margin="16,0,0,0"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
